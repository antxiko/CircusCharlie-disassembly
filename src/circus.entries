# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera del cartucho da INIT en 0x407B.
0x407B   # INIT, la direccion que trae la cabecera del cartucho

# ======================================================================
# EL GANCHO DE LA INTERRUPCION
# ======================================================================
# INIT no arranca ningun bucle de juego: escribe un `jp` (0xC3) en 0xFD9A y la
# direccion 0x402C en 0xFD9B, que es H.KEYI, y se queda en el `jr $` de 0x40A9.
# TODO el juego cuelga de la interrupcion, una vez por cuadro.
0x402C   # H.KEYI: lo engancha INIT en 0x4083 (`ld hl,0402ch / ld (0fd9bh),hl`)

# ======================================================================
# LAS TABLAS PEGADAS DETRAS DEL `call`
# ======================================================================
# El despachador de 0x404E es el de esta familia de Konami:
#
#     add a,a / pop hl / call L_4022 / ld e,(hl) / inc hl / ld d,(hl)
#     ex de,hl / jp (hl)
#
# El `pop hl` recupera su propia direccion de retorno, que es donde empieza la
# tabla, porque la tabla va PEGADA detras del `call`. El trazado no puede
# deducirlas siguiendo saltos.
#
# Cuantas entradas tiene no se estima: lo fija el encaje de que su PRIMERA
# entrada apunte justo detras de la tabla, que es donde sigue el codigo.
#
#   0x40C7 + 17*2 = 0x40E9, y su primera entrada es 0x40E9
#   0x40C7 + 17*2 = 0x40E9, y su primera entrada es 0x40E9
!tabla 0x40c7  17   # el reparto de escenas, desde el `call L_404E` de 0x40C4
!tabla 0x4c93   5   # desde 0x4C90; cierra en 0x4C9D, que es su entrada mas baja
!tabla 0x4cea  10   # desde 0x4CE7. Son DIEZ, no cinco: dos de sus entradas son 0x0000
                    # -huecos del reparto- y por eso el encaje crudo se paraba antes.
                    # Con diez cierra en 0x4CFE, que es su entrada mas baja no nula, y
                    # ademas dos de las cinco de mas (0x502D y 0x5000) son justamente
                    # los dos trozos de codigo que ninguna otra instruccion alcanza:
                    # sin esta tabla se quedaban sin explicar.
!tabla 0x5fef   5   # desde 0x5FEC; cierra en 0x5FF9, su entrada mas baja
!tabla 0x60b6   5   # desde 0x60B3; cierra en 0x60C0, su entrada mas baja

# ======================================================================
# LAS DIRECCIONES DE RETORNO EMPUJADAS A MANO
# ======================================================================
# 0x40AB elige una de dos y la APILA antes de caer en el despachador:
#
#     ld a,(0e002h) / and 040h
#     ld hl,044bah / jr nz,L_40BC / ld hl,0477dh
#     L_40BC: ld a,(0e000h) / cp 008h / jr z,L_40C4 / push hl
#
# O sea que la escena despachada, al hacer `ret`, sigue por 0x44BA o por
# 0x477D. El trazado no puede seguir un retorno fabricado. (Y con la escena 8
# no se apila nada: ese `jr z` se salta el `push`.)
0x44BA   # retorno apilado por 0x40AB cuando el bit 6 de (0xE002) esta a uno
0x477D   # retorno apilado por 0x40AB cuando esta a cero

# 0x5FE5 hace lo mismo antes de su despachador: `ld hl,0699dh / push hl` y cae
# en el `call L_404E` de 0x5FEC, o sea que la subescena vuelve por 0x699D.
0x699D   # retorno apilado por 0x5FE5

# ======================================================================
# LOS DOS TROZOS QUE NO ALCANZA NADIE
# ======================================================================
# Siete bytes en total. No son datos: desensamblan a instrucciones coherentes
# que encajan con el codigo de al lado. Lo que no hay es NINGUNA instruccion
# del cartucho que los alcance -buscadas las referencias a las dos direcciones
# en el listado entero, cero-, asi que el trazado no puede llegar por su
# cuenta. Son codigo que se quedo sin uso.

# `ld (0e03fh),a / jr L_4713`, pegado detras de los ocho registros del VDP y
# justo antes de L_472F. El `jr` cae dentro de L_4708, la rutina que vuelca
# esos mismos registros.
0x472A   # codigo huerfano: nadie lo llama

# `ld a,001h`, la otra puerta de la rutina de 0x5161: alli se entra con
# `xor a` y un `jr $+4` que salta POR ENCIMA de estos dos bytes, de modo que
# quien entrase aqui lo haria con A=1. Nadie entra.
0x5164   # codigo huerfano: la variante con A=1 de L_5161
